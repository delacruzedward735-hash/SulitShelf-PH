# Copy to .env.production, replace every required placeholder, and never commit it.
APP_ENV=production
APP_VERSION=2026.07.18
DOMAIN=shelf.example.com
SECRET_KEY=REPLACE_WITH_A_FRESH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

POSTGRES_DB=sulitshelf
POSTGRES_USER=sulitshelf
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
# URL-encode special characters in the password used in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://sulitshelf:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/sulitshelf

# Replace this placeholder. It is only the trusted CLI bootstrap/recovery target;
# public web and OAuth registrations are always promoter accounts.
ADMIN_EMAILS=admin@example.com
SERVICE_CONTACT_EMAIL=
TRUSTED_HOSTS=shelf.example.com
PUBLIC_BASE_URL=https://shelf.example.com
# Optional: paste only the token from Google Search Console's HTML-tag method.
GOOGLE_SITE_VERIFICATION=
OAUTH_REDIRECT_BASE_URL=https://shelf.example.com

RATELIMIT_STORAGE_URI=redis://redis:6379/0
# Optional bearer token for /health/heartbeat (generate at least 32 random characters).
HEARTBEAT_TOKEN=
IMAGE_STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=cloudinary://REPLACE_API_KEY:REPLACE_API_SECRET@REPLACE_CLOUD_NAME
CLOUDINARY_FOLDER=sulitshelf
CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=20
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_DIMENSION=1600

# Server-enforced growth-import and product-health limits.
CSV_IMPORT_MAX_BYTES=2000000
BULK_PRODUCT_MAX_ROWS=250
COMMISSION_MAX_ROWS=5000
PRODUCT_STALE_DAYS=30
COMMISSION_HASH_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# Enable after verifying MAIL_FROM_EMAIL with Resend or MailerSend.
PASSWORD_RESET_ENABLED=false
EMAIL_PROVIDER=auto
EMAIL_FAILOVER_ENABLED=true
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
TWO_FACTOR_CHALLENGE_MINUTES=5
MAIL_FROM_EMAIL=no-reply@shelf.example.com
MAIL_FROM_NAME=SulitShelf PH
RESEND_API_KEY=
MAILERSEND_API_TOKEN=

# Leave the API key empty to disable Dodo; manual Pro renewals and donations
# can still use the administrator-configured e-wallet QR and receipt review.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
# Keep true when the Dockerfile is deployed as one service (for example Render).
# Docker Compose overrides this for web because its migrate service runs first.
RUN_MIGRATIONS_ON_START=true
