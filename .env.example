APP_ENV=development
APP_VERSION=dev
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///sulitshelf.db
UPLOAD_ROOT=instance/uploads
# Default target for the trusted seed-admin/recover-admin CLI commands only.
# Public registrations are always promoters and never inherit this privilege.
ADMIN_EMAILS=admin@sulitshelf.local
SERVICE_CONTACT_EMAIL=
TRUSTED_HOSTS=
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0
PROXY_FIX_X_PORT=0
PROXY_FIX_X_PREFIX=0
RATELIMIT_STORAGE_URI=memory://
HEARTBEAT_TOKEN=
PUBLIC_BASE_URL=http://localhost:5000
GOOGLE_SITE_VERIFICATION=
OAUTH_REDIRECT_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
PASSWORD_RESET_ENABLED=false
EMAIL_PROVIDER=auto
EMAIL_FAILOVER_ENABLED=true
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
TWO_FACTOR_CHALLENGE_MINUTES=5
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SulitShelf PH
RESEND_API_KEY=
MAILERSEND_API_TOKEN=
IMAGE_STORAGE_BACKEND=auto
CLOUDINARY_URL=
CLOUDINARY_FOLDER=sulitshelf
CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=20
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_DIMENSION=1600
CSV_IMPORT_MAX_BYTES=2000000
BULK_PRODUCT_MAX_ROWS=250
COMMISSION_MAX_ROWS=5000
PRODUCT_STALE_DAYS=30
COMMISSION_HASH_KEY=replace-with-a-separate-long-random-value
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
