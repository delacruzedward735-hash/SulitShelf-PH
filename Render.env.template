# SulitShelf PH — Render production environment template
# Copy each key into Render > Web Service > Environment.
# Never commit real credentials. Generate SECRET_KEY, TWO_FACTOR_ENCRYPTION_KEY,
# COMMISSION_HASH_KEY, and HEARTBEAT_TOKEN as four separate values.

APP_ENV=production
APP_VERSION=render
SECRET_KEY=REPLACE_WITH_A_FRESH_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# Use the Render PostgreSQL INTERNAL URL. The application normalizes postgres://.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_INTERNAL_HOST/REPLACE_DATABASE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Trusted CLI bootstrap/recovery target only. Web registrations stay promoters.
ADMIN_EMAILS=REPLACE_WITH_YOUR_ADMIN_EMAIL
SERVICE_CONTACT_EMAIL=
TRUSTED_HOSTS=sulitshelf-ph.onrender.com
PUBLIC_BASE_URL=https://sulitshelf-ph.onrender.com
# Optional: paste only the token from Google Search Console's HTML-tag method.
GOOGLE_SITE_VERIFICATION=
OAUTH_REDIRECT_BASE_URL=https://sulitshelf-ph.onrender.com

SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=12
REMEMBER_COOKIE_DAYS=14
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=0
PROXY_FIX_X_PREFIX=0
FORWARDED_ALLOW_IPS=*
SECURITY_HSTS_SECONDS=31536000

# Use the Render Key Value INTERNAL URL. Do not use memory:// in production.
RATELIMIT_STORAGE_URI=redis://REPLACE_INTERNAL_REDIS_HOST:6379/0
HEARTBEAT_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# Cloudinary is required for production image persistence.
IMAGE_STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=cloudinary://REPLACE_API_KEY:REPLACE_API_SECRET@REPLACE_CLOUD_NAME
CLOUDINARY_FOLDER=sulitshelf
CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=20
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_DIMENSION=1600

# Import and product-health limits. Keep these defaults unless capacity is tested.
CSV_IMPORT_MAX_BYTES=2000000
BULK_PRODUCT_MAX_ROWS=250
COMMISSION_MAX_ROWS=5000
PRODUCT_STALE_DAYS=30
COMMISSION_HASH_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# OAuth providers are optional. Each enabled provider needs both values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0

# Password recovery is disabled until the sender domain and one provider are ready.
PASSWORD_RESET_ENABLED=false
EMAIL_PROVIDER=auto
EMAIL_FAILOVER_ENABLED=true
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_TOKEN_MINUTES=30
TWO_FACTOR_CHALLENGE_MINUTES=5
MAIL_FROM_EMAIL=no-reply@REPLACE_WITH_YOUR_VERIFIED_DOMAIN
MAIL_FROM_NAME=SulitShelf PH
RESEND_API_KEY=
MAILERSEND_API_TOKEN=

# Optional recurring Pro subscription. Leave blank to offer manual e-wallet renewal only.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode

LOG_LEVEL=INFO
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
RUN_MIGRATIONS_ON_START=true
